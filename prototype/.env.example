# Umgebungsvariablen für den Passkey-Prototyp (docker compose / natives Setup)
# Kopieren nach `.env` und Werte bei Bedarf anpassen. Alle Werte haben sichere
# Entwicklungs-Defaults — für ein Produktiv-Szenario MÜSSEN die Secrets ersetzt
# werden (R_OPS_TOKEN, HMAC-Secrets, KC-Admin-Passwort).

# --- Keycloak (Admin-Bootstrap & Setup-Service) ---------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASS=admin
# Secret des Service-Account-Client `portal-admin` (Portal-Backend-Admin-Aufrufe)
KC_ADMIN_CLIENT_SECRET=dev-portal-admin-secret

# --- URLs (Browser-Sicht des Nutzers) -------------------------------------
# Basis-URL des Portals (Redirect/Callback-Ziele)
PUBLIC_BASE_URL=http://localhost:8080
# Keycloak-Frontend-URL, so wie der Browser sie erreicht (== --hostname in KC)
KEYCLOAK_PUBLIC_URL=http://localhost:8082
# Verimi-Login-Seite/Logout-Rückleitung aus Browser-Sicht
VERIMI_LOGIN_URL=http://localhost:8081/login
VERIMI_PUBLIC_BASE_URL=http://localhost:8081
PORTAL_CALLBACK_URL=http://localhost:8080/api/auth/verimi/callback
# Server-seitig erreichbare Verimi-Basis für die Erreichbarkeits-Vorprüfung in
# API-01. In Docker MUSS das der Container-DNS-Name sein (nicht localhost); nativ
# kann der Wert entfallen (Fallback = VERIMI_LOGIN_URL).
# VERIMI_INTERNAL_URL=http://verimi-mock:3000/login

# --- Geheimnisse (Prototyp: gleiche Werte auf Portal- und Verimi-Seite) ----
VERIMI_HMAC_SECRET=verimi-mock-dev-secret
# R-OPS-Token für die Phasenschalter-API (API-05/06)
R_OPS_TOKEN=dev-rops-token

# --- Session / Auth (T-03: 15 Min) ----------------------------------------
SESSION_TTL_SECONDS=900
AUTH_TTL_SECONDS=600